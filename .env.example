# SokoBase settings. Copy this file to ".env" for local development, and add the same names in
# Vercel > Project > Settings > Environment Variables for production.
#
# Rules: NAME=value, no spaces around "=", no quotes, nothing after the value on the same line.
# NEXT_PUBLIC_* values are visible in the browser; all others are secret: never share or commit them.

# ---------------------------------------------------------------- Domains (required in production)
NEXT_PUBLIC_SITE_URL=https://sokobase.co.ke
NEXT_PUBLIC_SITE_HOST=sokobase.co.ke
NEXT_PUBLIC_PORTAL_URL=https://portal.sokobase.co.ke
NEXT_PUBLIC_PORTAL_HOST=portal.sokobase.co.ke

# ---------------------------------------------------------------- Supabase (required)
# Supabase > Project Settings > API (or Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "publishable" (or legacy "anon public") key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET. The "secret" (or legacy "service_role") key. Server only, full database access.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Cloudinary (images)
# Cloudinary > Settings > API Keys (dashboard home also shows the cloud name)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# A ~15-digit number, NOT the cloud name
CLOUDINARY_API_KEY=
# SECRET. The long API secret next to the key.
CLOUDINARY_API_SECRET=
# Only used if the two lines above are empty (development). Delete the unsigned preset in
# Cloudinary once signed uploads work, then leave this empty.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------- Contact details (shown on the site)
# WhatsApp number for "Talk to us" and renewal buttons, format 2547XXXXXXXX (no + or spaces)
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Shown on Contact, Privacy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@sokobase.co.ke
# Registered business name, shown as the operator in Privacy and Terms
NEXT_PUBLIC_LEGAL_NAME=

# ---------------------------------------------------------------- Google
# Google Analytics 4 measurement ID (the old site used G-S7NZVGMCDJ; keep it to keep your history)
NEXT_PUBLIC_GA_ID=
# Search Console "HTML tag" method: paste ONLY the content="..." value, not the whole <meta> tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------- Security
# SECRET. Any long random string (40+ characters). Used to anonymise order-click statistics.
ORDER_CLICK_SALT=
# Optional bot protection on sign-in and password reset: Cloudflare > Turnstile > Add site
# (add both sokobase.co.ke and portal.sokobase.co.ke). Leave both empty to switch off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- Error alerts (optional, recommended)
# sentry.io > Create project > Next.js > copy the DSN. Leave empty to switch off.
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------- Local tools only (not needed in Vercel)
# For "npm run check:security" owner checks: a TEST business account (not a real shop)
# TEST_OWNER_EMAIL=
# TEST_OWNER_PASSWORD=
